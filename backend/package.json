{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "types": "commonjs",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
    "build": "tsc",
    "start": "node --import ./src/instrument.ts dist/index.js",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@clerk/backend": "^3.16.13",
    "@clerk/express": "^2.1.64",
    "@imagekit/nodejs": "^7.11.0",
    "@sentry/node": "^10.73.0",
    "@sentry/profiling-node": "^10.73.0",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "standardwebhooks": "^1.1.1",
    "stream-chat": "^9.52.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
